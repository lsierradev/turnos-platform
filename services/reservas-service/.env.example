PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/turnos_platform
REDIS_URL=redis://localhost:6379

# Zona horaria del taller (IANA). Define el horario laboral (8-18 local), el
# corte de dias de la agenda y del dashboard, y la hora de los recordatorios.
# No es la zona del proceso: el servicio da lo mismo corriendo en UTC. Debe
# coincidir con VITE_TZ_NEGOCIO de admin-web. Default: America/Bogota.
TZ_NEGOCIO=America/Bogota

# Debe coincidir con JWT_SECRET de usuarios-service: es el mismo emisor de
# tokens, y este servicio solo valida (no firma) access tokens.
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m

# Debe coincidir con ENCRYPTION_KEY de usuarios-service: NotificationsScheduler
# necesita desencriptar Usuario.telefono para mandar el recordatorio por
# WhatsApp (Sprint 6).
ENCRYPTION_KEY=

# RF-03: recordatorio 24h antes del turno (Sprint 6).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@turnos-platform.dev
