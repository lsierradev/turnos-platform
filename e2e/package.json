{
  "name": "@turnos-platform/e2e",
  "version": "0.0.1",
  "private": true,
  "description": "Suite end-to-end (Playwright) de las 4 Historias de Usuario del SRS.",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "tsc --noEmit",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:visual:actualizar": "playwright test -c playwright.visual.config.ts --update-snapshots"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "typescript": "^5.5.4"
  }
}
