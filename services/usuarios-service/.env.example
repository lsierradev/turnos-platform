PORT=3002
DATABASE_URL=postgres://postgres:postgres@localhost:5432/turnos_platform

JWT_SECRET=change-me
JWT_EXPIRES_IN=15m

JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=7d

# Clave hex de 64 caracteres (32 bytes) para AES-256-GCM.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Correos de contrasena (Sprint 18): enlace para definirla al dar de alta un
# cliente y "Olvide mi contrasena". Sin SENDGRID_* el correo NO se envia:
# queda en el log del servicio (util en dev para copiar el enlace).
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@turnos-platform.dev
# Sin SendGrid y fuera de produccion, cada correo queda como .txt en esta
# carpeta (default ./.correos) para copiar el enlace sin buscarlo en el log.
# CORREO_BUZON_DIR=./.correos
# Donde vive admin-web: base de los enlaces que van en el correo.
WEB_URL=http://localhost:5173
